# Telegram (von @BotFather bzw. @userinfobot, siehe README)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# Wird von Railway automatisch gesetzt, sobald ein Postgres-Addon verbunden ist.
# Fuer lokales Testen kannst du die Zeile auskommentiert lassen (dann wird lokal
# sqlite genutzt, siehe app/config.py).
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/dbname

# Oeffentliche URL dieses Services, z.B. https://dein-projekt.up.railway.app
# Wird sowohl fuer den Telegram-Webhook als auch fuer die oeffentliche Video-URL
# gebraucht, die Instagram beim Publish abruft (siehe app/storage.py).
WEBHOOK_BASE_URL=

# Frei waehlbares Passwort, das den /cron Endpoint schuetzt
CRON_SECRET=

# --- Schritt 2: Instagram (siehe README) ---
IG_ACCESS_TOKEN=
IG_BUSINESS_ACCOUNT_ID=

# --- Schritt 2: YouTube (siehe README) ---
YT_CLIENT_SECRET_FILE=yt_client_secret.json
YT_TOKEN_FILE=yt_token.json
